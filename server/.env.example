# Web2APK Backend Server Configuration

PORT=3000
NODE_ENV=production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Storage & Upload Security
UPLOAD_DIR=./uploads
ARTIFACT_DIR=./artifacts
MAX_UPLOAD_SIZE_MB=50
MAX_UNCOMPRESSED_SIZE_MB=250
ZIP_MAX_FILES=1000

# Build Worker Configuration
BUILD_TIMEOUT_MINUTES=45
CONCURRENT_BUILD_LIMIT=4
GRADLE_USER_HOME=~/.gradle

# Security & Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production
ADMIN_API_KEY=admin_secret_api_key_for_internal_metrics

# Keystore Signing (CI/CD / Release)
KEYSTORE_BASE64=
KEYSTORE_PASSWORD=
KEY_ALIAS=upload
KEY_PASSWORD=
